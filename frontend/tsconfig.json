{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings (Upgraded for Node.js backend & Browser ES Modules)
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",

    // CRITICAL: Keep "DOM" for the browser editor, and support modern JS/Node
    "lib": ["ES2022", "DOM"], 

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  
  "include": ["src/**/*"]
}

