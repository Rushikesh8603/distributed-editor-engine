{
  "compilerOptions": {
    // File Layout (Uncommented so tsc knows where to read and write)
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings (Updated for Browser ES Modules)
    "module": "ES2020",
    "target": "ES2020",

    
    // CRITICAL: We need "DOM" so TypeScript recognizes document.getElementById and HTMLTextAreaElement
    "lib": ["ES2020", "DOM"], 
    "types": [],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    // "jsx": "react-jsx", <-- Commented out for now since we are using Vanilla HTML
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  
  // Explicitly tell TypeScript to compile everything inside the src folder
  "include": ["src/**/*"]
}


